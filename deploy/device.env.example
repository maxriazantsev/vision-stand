# Copied to /etc/vision-stand/device.env on each device by
# provision_device.sh. Safe to hand-edit afterward and restart the
# relevant service(s) to pick up a change.

# Isolates this project's ROS graph from anything else on the LAN. Must
# match scripts/env.sh, which carries the same value for the dev machine.
ROS_DOMAIN_ID=42

# Stable camera device path, e.g. /dev/v4l/by-id/usb-...-video-index0.
# Auto-detected and filled in by provision_device.sh.
CAMERA_SOURCE=

# Leave empty to follow the latest published GitHub release.
# Set to an exact tag (e.g. v1.2.0) to pin this device to one version
# instead of auto-updating.
PINNED_VERSION=
