<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>detector</name>
    <!-- Not the real version. That comes from the GitHub release tag at
         build time (see Dockerfile). This field only exists because
         package_format3.xsd requires one. -->
    <version>0.0.0</version>
    <description>Vision Stand: camera + on-device object detection pipeline for a networked Raspberry Pi vision stand.
    </description>
    <maintainer email="m4xh17@gmail.com">max</maintainer>
    <license>MIT</license>

    <exec_depend>rclpy</exec_depend>
    <exec_depend>std_msgs</exec_depend>
    <exec_depend>sensor_msgs</exec_depend>
    <exec_depend>vision_msgs</exec_depend>
    <exec_depend>std_srvs</exec_depend>
    <exec_depend>cv_bridge</exec_depend>
    <exec_depend>python3-opencv</exec_depend>
    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>image_transport</exec_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
